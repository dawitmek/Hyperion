{
  "hyperion": "game-actions",
  "version": 1,
  "name": "Minecraft Bedrock starter",
  "author": "Hyperion",
  "description": "Eight actions from the Minecraft guide: mobs, TNT, diamonds, weather and more.",
  "actions": [
    {
      "name": "Creeper",
      "game": "minecraftBedrock",
      "commands": [
        "summon creeper ~ ~ ~",
        "titleraw @a actionbar {\"rawtext\":[{\"text\":\"§a{viewer} sent a creeper!\"}]}"
      ],
      "repeat": 1,
      "delayMs": 0
    },
    {
      "name": "Named zombie",
      "game": "minecraftBedrock",
      "commands": [
        "summon zombie \"{viewer}\" ~ ~ ~",
        "titleraw @a actionbar {\"rawtext\":[{\"text\":\"§2{viewer} joined as a zombie!\"}]}"
      ],
      "repeat": 1,
      "delayMs": 0
    },
    {
      "name": "TNT rain",
      "game": "minecraftBedrock",
      "commands": [
        "summon tnt ~ ~8 ~",
        "titleraw @a actionbar {\"rawtext\":[{\"text\":\"§c{viewer} made it rain TNT!\"}]}"
      ],
      "repeat": 5,
      "delayMs": 1000
    },
    {
      "name": "Diamonds",
      "game": "minecraftBedrock",
      "commands": [
        "give @s diamond {count}",
        "titleraw @a actionbar {\"rawtext\":[{\"text\":\"§b{viewer} sent {count} diamonds!\"}]}"
      ],
      "repeat": 1,
      "delayMs": 0
    },
    {
      "name": "Lightning",
      "game": "minecraftBedrock",
      "commands": [
        "summon lightning_bolt ~ ~ ~",
        "titleraw @a actionbar {\"rawtext\":[{\"text\":\"§e{viewer} called down lightning!\"}]}"
      ],
      "repeat": 1,
      "delayMs": 0
    },
    {
      "name": "Thunderstorm",
      "game": "minecraftBedrock",
      "commands": [
        "weather thunder",
        "time set night",
        "titleraw @a actionbar {\"rawtext\":[{\"text\":\"§9{viewer} brought the storm!\"}]}"
      ],
      "repeat": 1,
      "delayMs": 0
    },
    {
      "name": "Speed boost",
      "game": "minecraftBedrock",
      "commands": [
        "effect @s speed 30 2",
        "titleraw @a actionbar {\"rawtext\":[{\"text\":\"§d{viewer} gave you a speed boost!\"}]}"
      ],
      "repeat": 1,
      "delayMs": 0
    },
    {
      "name": "Random teleport",
      "game": "minecraftBedrock",
      "commands": [
        "spreadplayers ~ ~ 0 50 @s",
        "titleraw @a actionbar {\"rawtext\":[{\"text\":\"§5{viewer} teleported you!\"}]}"
      ],
      "repeat": 1,
      "delayMs": 0
    }
  ]
}