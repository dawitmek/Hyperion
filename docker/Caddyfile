{
	# Behind Cloudflare's proxy every connection comes from Cloudflare, so take the visitor's address from the header it
	# sets. Only trusted from Cloudflare's ranges (cloudflare.com/ips), so nobody else can fake it. Harmless without Cloudflare.
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}

	# Caddy's own warnings and errors (certificates, Hyperion not answering). Also in `docker compose logs caddy`.
	log errors {
		output file /var/log/caddy/error.log {
			roll_size 10MiB
			roll_keep 5
		}
		level WARN
	}
}

{$DOMAIN} {
	# Every request, one JSON line each. Overlay links are secrets, so their tokens are blanked like in the server's log.
	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 10
		}
		format filter {
			request>uri regexp "^/overlay/[^/?#]+" "/overlay/[redacted]"
			request>uri regexp "([?&]token=)[^&#]*" "${1}[redacted]"
		}
	}
	# Hand Hyperion just the visitor's address, so its rate limits apply per visitor rather than per Cloudflare server.
	reverse_proxy hyperion:3000 {
		header_up X-Forwarded-For {client_ip}
	}
}
