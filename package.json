{
  "name": "hyperion",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/theme",
    "apps/server",
    "apps/web",
    "apps/companion"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:shared": "npm run dev -w packages/shared",
    "build": "npm run build -w packages/shared -w apps/server -w apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:server": "npm run dev -w apps/server",
    "dev:web": "npm run dev -w apps/web",
    "start": "npm run start -w apps/server",
    "db:up": "docker compose -f docker/compose.dev.yml -p hyperion up -d",
    "db:down": "docker compose -f docker/compose.dev.yml -p hyperion down",
    "test": "npm run build -w packages/shared && vitest run",
    "companion:dev": "npm run tauri -w apps/companion -- dev",
    "companion:build": "npm run tauri -w apps/companion -- build",
    "companion:build:app": "npm run tauri -w apps/companion -- build --bundles app",
    "companion:build:universal": "rustup target add x86_64-apple-darwin aarch64-apple-darwin && npm run tauri -w apps/companion -- build --target universal-apple-darwin"
  },
  "devDependencies": {
    "concurrently": "^9.2.5",
    "vitest": "^5.0.5"
  }
}
