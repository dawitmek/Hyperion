# Hyperion settings. Copy this file to .env, then fill in the sections for how you're running it:
#   Self-hosting with Docker:  sections 1 and 2. Ignore section 3.
#   Local development:         sections 2 and 3. `npm run dev` creates .env and SECRETS_KEY for you.


# ============================================================================
# 1. SELF-HOSTING WITH DOCKER
# Start it from the project folder, with --env-file, or Docker won't find this file:
#   docker compose -f docker/compose.yml --env-file .env up -d --build
# Step-by-step guide: docs/SELF_HOSTING.md
# ============================================================================

# Required. Password for the bundled database. Letters and numbers only. Generate with: openssl rand -hex 24
# Set it before the first start: changing it later doesn't change the database's password.
POSTGRES_PASSWORD=

# The port you open Hyperion on. Change it if another program already uses 3000.
HYPERION_PORT=3000

# Who can reach that port. 127.0.0.1 is this machine only; 0.0.0.0 is every device on your network.
HYPERION_BIND=127.0.0.1

# Automatic HTTPS with the bundled Caddy. Uncomment both and use your own domain.
# DOMAIN=hyperion.example.com
# COMPOSE_PROFILES=https

# Only for plain HTTP on a private network, or logins won't stick. Leave it out behind HTTPS.
# COOKIE_SECURE=false

# Your reverse proxy's addresses, or none if there isn't one.
# TRUST_PROXY=loopback,uniquelocal


# ============================================================================
# 2. BOTH SELF-HOSTING AND LOCAL DEVELOPMENT
# ============================================================================

# Required. Encrypts hosts' API keys and TikTok sessions in the database. Generate with: openssl rand -base64 32
# Keep it safe and don't change it: without it, saved keys and sessions can't be read and must be entered again.
SECRETS_KEY=

# Optional. Euler Stream key for TikTok signing (https://www.eulerstream.com)
EULER_API_KEY=

# Optional. A TikTok account for TikTok voices, used by every host who hasn't signed in with their own in the
# companion. The value of that account's sessionid cookie. Use a spare account: the TikTok voice API is unofficial.
TIKTOK_SESSION_ID=


# ============================================================================
# 3. LOCAL DEVELOPMENT ONLY
# Docker ignores everything here. The defaults work with `npm run dev`.
# ============================================================================

DATABASE_URL=postgres://hyperion:hyperion@127.0.0.1:5432/hyperion

# Change if another program already uses 3000; the dashboard dev server (npm run dev) follows it.
PORT=3000
HOST=127.0.0.1

# Optional server-side text-to-speech. The Docker image sets these itself.
# PIPER_BIN=/path/to/piper
# PIPER_VOICES_DIR=/path/to/voices

# Optional. A file for the debug log, which follows live sessions, read-aloud chat and alerts from the server through
# to what each overlay plays. Relative to apps/server. Ignored when NODE_ENV=production.
# DEBUG_LOG=logs/debug.log
